# Build directories
/build/
/build-*/
/out/
cmake-build-*/

# Packaging output and downloaded packaging tools
/dist/
packaging/appimage/.tools/

# makepkg working directories, left behind by building an AUR package in place.
# The PKGBUILDs themselves are tracked; everything makepkg produces is not.
packaging/aur/*/src/
packaging/aur/*/pkg/
packaging/aur/*/*.pkg.tar.*
packaging/aur/*/*.tar.gz

# Never commit private key material.
*.key
*.pem

# Tooling
compile_commands.json
.cache/
.clangd/

# Qt
*.user
*.autosave

# Editor / OS
.vscode/
.idea/
*.swp
*~
.DS_Store

