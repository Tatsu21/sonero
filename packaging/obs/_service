<services>
  <!-- All of these run on the OBS server, on every runservice trigger (see the
       obs job in .github/workflows/ci.yml), and the build only ever sees their
       results: a tarball of main and a spec with its Version filled in.
       Not mode="buildtime": that installs the obs-service-* packages into every
       build root, and on Fedora their dependencies are ambiguous (wget1 or
       wget2, which glibc langpack) — OBS refuses to choose, so the build never
       starts. -->
  <service name="tar_scm">
    <param name="url">https://github.com/Tatsu21/sonero.git</param>
    <param name="scm">git</param>
    <param name="revision">main</param>
    <param name="filename">sonero</param>
    <!-- Release tags are bare numbers; "dev" is the moving rolling-build tag
         and must not become the version. -->
    <param name="match-tag">[0-9]*</param>
    <param name="versionformat">@PARENT_TAG@+git@TAG_OFFSET@.%h</param>
  </service>
  <service name="recompress">
    <param name="file">*.tar</param>
    <param name="compression">xz</param>
  </service>
  <service name="set_version"/>
</services>
